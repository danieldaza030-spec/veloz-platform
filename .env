# Local-dev only. Values here are placeholders, not secrets — safe to commit.
#
# AIRFLOW_UID: host UID that container processes run as, so bind-mounted
# ./dags, ./logs, ./data, ./generators keep sane ownership on the host.
# On Linux, override with your real UID: `echo "AIRFLOW_UID=$(id -u)" >> .env`
# (or edit this file directly). macOS/OrbStack doesn't need this — Docker
# Desktop/OrbStack's filesystem bridge maps ownership for you — so the
# Airflow-recommended default of 50000 is fine as-is.
AIRFLOW_UID=50000

# Bootstrap admin user created once by the airflow-init service. Obviously
# local-only — this UI is only ever reachable at localhost:8080 on this machine.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=veloz-local-dev

# MinIO root: owns the server, used by minio-init to create everything below
# and by a human logging into the console at localhost:9001.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=veloz-local-dev

# Default role for every DAG-driven Bronze/Silver/Gold write: read/write/list on
# the three buckets, no delete. Wired to AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# in docker-compose.yml, so Spark picks it up without being asked.
MINIO_INGEST_ACCESS_KEY=veloz-ingest
MINIO_INGEST_SECRET_KEY=veloz-ingest-local-dev

# Full CRUD, for deliberate OPTIMIZE/VACUUM runs only. Passed into Airflow under
# these exact names — a job has to reference them on purpose to get delete rights.
MINIO_MAINTENANCE_ACCESS_KEY=veloz-maintenance
MINIO_MAINTENANCE_SECRET_KEY=veloz-maintenance-local-dev

# Spark Standalone cluster (docker-compose.yml's spark-master/spark-worker
# services, replacing the earlier Hadoop YARN cluster). To change the worker
# pool size or its per-instance resource caps, edit the values below and
# re-run `docker compose up -d` — no `--scale` flag needed, `deploy.replicas`
# is honored directly by `docker compose up` under Compose V2.
SPARK_WORKER_COUNT=4
# Real per-container cgroup CPU quota (deploy.resources.limits.cpus) AND the
# value passed as this worker's own `--cores` flag — kept as one number so a
# worker never advertises more cores to spark-master than its container
# actually has. Same pattern YARN_NODEMANAGER_CPU_LIMIT used for the
# NodeManager pool this replaces.
SPARK_WORKER_CPU_LIMIT=2
# Real per-container cgroup memory limit, in MB (docker-compose.yml appends
# the "M" suffix deploy.resources.limits.memory expects). *Not* passed to
# Spark's own `--memory` flag as this bare number, though: Spark's Worker
# parses that flag as a memory string ("4096m"), not an MB integer the way
# YARN's yarn.nodemanager.resource.memory-mb was — docker-compose.yml appends
# the "m" suffix itself when building that flag, so this one number still
# drives both without silently under/over-advertising what the worker can
# deliver.
SPARK_WORKER_MEM_LIMIT=4096
# Host port for the Spark Master UI (http://localhost:8090). Not Spark's own
# default 8080 — airflow-apiserver already owns that port on this host.
SPARK_MASTER_UI_PORT=8090
