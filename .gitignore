# Python
.venv/
__pycache__/
*.pyc

# Airflow local-dev (docker-compose bind mount, regenerated each run)
logs/*
!logs/.gitkeep
config/*
!config/.gitkeep

# plugins/ holds real, checked-in cross-DAG-importable code (e.g.
# plugins/spark_session.py) despite living under a docker-compose bind
# mount — only __pycache__ is regenerated, not the source itself.
plugins/__pycache__/

# Faker-generated raw data (regenerated by generators/*.py, not source)
data/raw/*
!data/raw/.gitkeep

# MinIO object store (docker-compose bind mount, recreated by minio-init)
data/minio/*
!data/minio/.gitkeep

# macOS
.DS_Store

# Editors
.vscode/
.idea/
